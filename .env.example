# JWT Configuration
# REQUIRED: JWT_SECRET must be at least 32 characters (256-bit entropy) for HS256 security
# Weak secrets like 'secret' or 'changeme' are vulnerable to offline brute-force attacks
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_base64_32

# Server Configuration
PORT=8081
HOST=0.0.0.0

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Environment
ENV=development

# Log Level
LOG_LEVEL=info
